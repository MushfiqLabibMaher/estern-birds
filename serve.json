{
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/birds", "destination": "/birds.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
